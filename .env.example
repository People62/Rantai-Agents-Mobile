# ============================================
# Backend API — RantAI Agents (template)
# ============================================
# Salin file ini menjadi .env lalu isi nilainya. Dibaca oleh react-native-config
# (import Config from 'react-native-config'). Nilai di-bake saat BUILD native —
# setelah mengubah .env, jalankan ulang `bun run android` (rebuild).
#
# Pilih sesuai target:
#   HP fisik (WiFi sama) : http://<IP-LAN-komputer>:3000
#   Emulator Android     : http://10.0.2.2:3000
#   Simulator iOS        : http://localhost:3000
API_URL=http://192.168.18.93:3000

# ============================================
# Multi-environment (release builds)
# ============================================
# react-native-config memilih file via variabel ENVFILE (default: .env).
#   Dev (debug, Metro)    : .env            → bun run android
#   Staging (internal)    : .env.staging    → ENVFILE=.env.staging ./gradlew bundleRelease
#   Produksi              : .env.production → ENVFILE=.env.production ./gradlew bundleRelease
# `.env.staging` & `.env.production` sudah ada (URL publik, boleh di-commit).
# `.env` (dev, berisi IP LAN lokal) tetap gitignored.

# ============================================
# Google Sign-In (native SDK)
# ============================================
# Web/server OAuth Client ID (dari GOOGLE_CLIENT_ID backend). PUBLIK — memang
# didesain muncul di app; ini BUKAN GOOGLE_CLIENT_SECRET (jangan pernah taruh
# secret di app mobile). Sama untuk semua environment.
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxx.apps.googleusercontent.com
