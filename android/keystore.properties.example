# Release signing — copy this to `android/keystore.properties` (gitignored) and
# fill it with your OWN release key. NEVER commit the real file or the keystore.
#
# 1) Generate the keystore (run once, keep the passwords safe — losing them means
#    you can never update the app on the Play Store):
#
#      cd android/app
#      keytool -genkeypair -v -storetype PKCS12 \
#        -keystore release.keystore -alias rantai \
#        -keyalg RSA -keysize 2048 -validity 10000
#
# 2) Put the values below into android/keystore.properties.

RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=your-store-password
RELEASE_KEY_ALIAS=rantai
RELEASE_KEY_PASSWORD=your-key-password
